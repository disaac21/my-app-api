// Vehicle hub schema.
//
// Design rules:
//  - `params` is a key/value registry. Every unit, currency, enum value and
//    scalar setting is a row: `(kind, key) -> value (jsonb)`. Adding a fuel
//    type or maintenance type is data, not a migration.
//  - Rows still have an `id`, so all `*Id` columns can keep real foreign keys
//    and `onDelete: Restrict` protection. This is the only way to have both a
//    KV table and referential integrity: Postgres cannot FK into JSON.
//  - `ParamKind` is the only native enum: it is the shape of the registry that
//    code must switch on. Everything under a kind is data.
//  - All measurements are stored in the BASE unit declared in `params`
//    (`value.isBase = true` for DISTANCE_UNIT / VOLUME_UNIT / PRESSURE_UNIT).
//    Base units are immutable. Never flip `isBase` on a live database.
//  - Money is Decimal, never Float. Timestamps are timestamptz. Dates are date.
//  - Derived values ARE stored (pricePerUnit, efficiency, tripDistance,
//    currentOdometer, nextDueAt/nextDueDistance) for cheap reads. Every write
//    path that can change an input must recompute them.
//  - Nothing is deleted by cascade. Child FKs use onDelete: Restrict; deleting
//    a vehicle is a soft delete (isActive = false) that also archives its
//    documents. No history is lost, and a mistaken delete is reversible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ParamKind {
  // unit configuration (value: { label, symbol, factorToBase, isBase, sortOrder })
  DISTANCE_UNIT
  VOLUME_UNIT
  PRESSURE_UNIT
  // selectable value sets (value: { label, sortOrder })
  CURRENCY
  FUEL_TYPE
  TRANSMISSION_TYPE
  DRIVE_TYPE
  MAINTENANCE_TYPE
  DOCUMENT_TYPE
  DOCUMENT_GROUP
  READING_SOURCE
  // scalar app settings (value: any JSON, e.g. "KM")
  SETTING
}

/// One row per parameter, unit, or enum value.
///
/// value shapes by kind:
///   DISTANCE_UNIT   { "label": "Miles", "symbol": "mi",
///                     "factorToBase": 1.609344, "isBase": false, "sortOrder": 1 }
///   FUEL_TYPE       { "label": "Diesel", "sortOrder": 1 }
///   SETTING         "KM"            // arbitrary JSON; the setting's value
model Param {
  id       String    @id @default(cuid())
  kind     ParamKind
  /// Stable identifier used by code and the API ("KM", "DIESEL", "OIL").
  /// Treat as a contract: edit labels inside `value`, never rename `key`.
  key      String
  value    Json
  /// Retire a value instead of deleting it. Referenced rows cannot be deleted
  /// anyway (onDelete: Restrict on every FK below).
  isActive Boolean   @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  vehiclesByFuelType     Vehicle[] @relation("VehicleFuelType")
  vehiclesByTransmission Vehicle[] @relation("VehicleTransmission")
  vehiclesByDriveType    Vehicle[] @relation("VehicleDriveType")

  readings           VehicleReading[]   @relation("ReadingSource")
  fuelEntries        FuelEntry[]        @relation("FuelEntryFuelType")
  maintenanceEntries MaintenanceEntry[] @relation("MaintenanceEntryType")
  maintenancePlans   MaintenancePlan[]  @relation("MaintenancePlanType")
  documents          VehicleDocument[]  @relation("DocumentType")
  documentGroups     VehicleDocument[]  @relation("DocumentGroup")

  @@unique([kind, key])
  @@index([kind])
  @@map("params")
}

model Make {
  id     String  @id @default(cuid())
  name   String  @unique
  models Model[]

  @@map("makes")
}

/// A model always belongs to exactly one make, so `Vehicle` only stores
/// `modelId` — the make is reached through the relation, never duplicated.
model Model {
  id       String    @id @default(cuid())
  makeId   String
  make     Make      @relation(fields: [makeId], references: [id], onDelete: Restrict)
  name     String
  vehicles Vehicle[]

  @@unique([makeId, name])
  @@index([makeId])
  @@map("models")
}

model Vehicle {
  id      String @id @default(cuid())
  modelId String
  model   Model  @relation(fields: [modelId], references: [id], onDelete: Restrict)

  year     Int
  trim     String?
  nickname String?
  /// Required and unique: with VIN gone this is the vehicle's identity.
  plate    String  @unique
  colorHex String? @db.VarChar(7) // #RRGGBB

  engine         String?
  fuelTypeId     String?
  fuelType       Param?  @relation("VehicleFuelType", fields: [fuelTypeId], references: [id], onDelete: Restrict)
  transmissionId String?
  transmission   Param?  @relation("VehicleTransmission", fields: [transmissionId], references: [id], onDelete: Restrict)
  driveTypeId    String?
  driveType      Param?  @relation("VehicleDriveType", fields: [driveTypeId], references: [id], onDelete: Restrict)

  /// Stored in the base volume unit (params.VOLUME_UNIT where value.isBase).
  tankCapacity      Decimal? @db.Decimal(6, 1)
  /// Stored in the base pressure unit (params.PRESSURE_UNIT where value.isBase).
  tirePressureFront Int?
  tirePressureRear  Int?

  oilType          String?
  oilSpecification String?
  batteryVoltage   Decimal? @db.Decimal(4, 1)

  /// Derived cache of the latest reading. Stored in the base distance unit.
  currentOdometer Decimal? @db.Decimal(10, 1)

  readings           VehicleReading[]
  fuelEntries        FuelEntry[]
  maintenanceEntries MaintenanceEntry[]
  maintenancePlans   MaintenancePlan[]
  documents          VehicleDocument[]

  /// Soft-delete flag. "Deleting" a vehicle sets this to false and touches no
  /// child rows. Restore by reactivating the same row — the plate stays
  /// reserved, so there is deliberately no duplicate-create path.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([modelId])
  @@map("vehicles")
}

/// Merged odometer + fuel-level timeline (replaces odometer_readings and
/// quick_updates). At least one measurement must be present.
model VehicleReading {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  odometer     Decimal? @db.Decimal(10, 1)
  fuelLevelPct Int?
  sourceId     String?
  source       Param?   @relation("ReadingSource", fields: [sourceId], references: [id], onDelete: Restrict)

  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  notes      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, recordedAt(sort: Desc)])
  @@map("vehicle_readings")
}

model FuelEntry {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  filledAt DateTime @default(now()) @db.Timestamptz(3)

  /// Stored in the base distance unit.
  odometer Decimal @db.Decimal(10, 1)
  /// Stored in the base volume unit.
  volume   Decimal @db.Decimal(8, 3)

  priceTotal Decimal @db.Decimal(12, 2)

  station    String?
  fuelTypeId String?
  fuelType   Param?  @relation("FuelEntryFuelType", fields: [fuelTypeId], references: [id], onDelete: Restrict)

  /// Both flags are required for correct fuel-economy maths: a partial fill-up
  /// or a skipped logging session breaks the distance/volume ratio.
  isFullTank          Boolean @default(true)
  missedPreviousEntry Boolean @default(false)

  // ── stored derived values ──────────────────────────────────────────────
  /// priceTotal / volume.
  pricePerUnit Decimal? @db.Decimal(12, 4)
  /// distance since the previous fill / volume, in base distance per base volume.
  efficiency   Decimal? @db.Decimal(8, 3)
  /// odometer - previous odometer, in base distance.
  tripDistance Decimal? @db.Decimal(10, 1)

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, filledAt(sort: Desc)])
  @@map("fuel_entries")
}

/// Work that was actually done. Scheduling lives in MaintenancePlan.
model MaintenanceEntry {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  typeId String
  type   Param  @relation("MaintenanceEntryType", fields: [typeId], references: [id], onDelete: Restrict)

  title       String?
  description String?

  performedAt DateTime @default(now()) @db.Timestamptz(3)
  /// Stored in the base distance unit.
  odometer    Decimal? @db.Decimal(10, 1)
  cost        Decimal? @db.Decimal(12, 2)
  shop        String?
  notes       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, performedAt(sort: Desc)])
  @@index([typeId])
  @@map("maintenance_entries")
}

/// Work that is due. One row per recurring job.
model MaintenancePlan {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  typeId String
  type   Param  @relation("MaintenancePlanType", fields: [typeId], references: [id], onDelete: Restrict)

  /// Stored in the base distance unit.
  intervalDistance Int?
  intervalMonths   Int?

  lastDoneAt      DateTime? @db.Timestamptz(3)
  /// Derived cache: lastDoneAt + intervalMonths.
  nextDueAt       DateTime? @db.Timestamptz(3)
  /// Stored in the base distance unit. Derived cache: last odometer + intervalDistance.
  nextDueDistance Int?

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, nextDueAt])
  @@index([typeId])
  @@map("maintenance_plans")
}

/// Documents. `group` splits personal documents (driver's licence) from
/// vehicle documents (insurance, registration); `vehicleId` is optional so a
/// personal document is stored once and not duplicated per car.
///
/// Documents are archived, never deleted: deactivating a vehicle also sets
/// `isActive = false` on its documents, and replacing an expired policy is a
/// deactivate + insert, so you keep the history.
model VehicleDocument {
  id String @id @default(cuid())

  groupId String
  group   Param  @relation("DocumentGroup", fields: [groupId], references: [id], onDelete: Restrict)

  typeId String
  type   Param  @relation("DocumentType", fields: [typeId], references: [id], onDelete: Restrict)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  number   String?
  provider String? // insurer / issuing authority

  issuedAt  DateTime? @db.Date
  expiresAt DateTime? @db.Date
  cost      Decimal?  @db.Decimal(12, 2)

  fileUrl String?
  notes   String?

  /// Archived instead of deleted. Set to false when its vehicle is deactivated.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, isActive])
  @@index([groupId, typeId, expiresAt(sort: Desc)])
  @@map("vehicle_documents")
}
