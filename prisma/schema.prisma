// Vehicle hub schema.
//
// Design rules:
//  - `params` is a key/value registry: ONE row per kind, `value` is an ordered
//    JSON array of options.
//      key:   "FUEL_TYPE"
//      value: [{ "key": "GASOLINE", "label": "Gasoline / Petrol" },
//              { "key": "DIESEL",   "label": "Diesel" }]
//    Array order is display order. The first entry is the default.
//  - Options are referenced by their `key` string, e.g.
//    vehicles."fuelType" = 'DIESEL'. There are deliberately no foreign keys
//    into `params`: Postgres cannot FK into a JSON array. ParamsService is
//    responsible for rejecting unknown codes.
//  - Unit conversion maths lives in code (storage units are km, L, kPa).
//    `params` only carries labels and symbols for display.
//  - Money is Decimal, never Float. Timestamps are timestamptz. Dates are date.
//  - Derived values ARE stored (pricePerUnit, efficiency, tripDistance,
//    currentOdometer, nextDueAt/nextDueDistance) for cheap reads. Every write
//    path that can change an input must recompute them.
//  - Nothing is deleted by cascade. Child FKs use onDelete: Restrict; deleting
//    a vehicle is a soft delete (isActive = false) that also archives its
//    documents. No history is lost, and a mistaken delete is reversible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per kind of option list. Known keys:
///   DISTANCE_UNIT, VOLUME_UNIT, PRESSURE_UNIT, CURRENCY,
///   FUEL_TYPE, TRANSMISSION_TYPE, DRIVE_TYPE, MAINTENANCE_TYPE,
///   DOCUMENT_TYPE, DOCUMENT_GROUP, READING_SOURCE
///
/// value shapes:
///   DISTANCE_UNIT / VOLUME_UNIT / PRESSURE_UNIT
///     [{ "key": "MI", "label": "Miles", "symbol": "mi" }, ...]
///   CURRENCY
///     [{ "key": "USD", "label": "US Dollar", "symbol": "$" }, ...]
///   everything else
///     [{ "key": "DIESEL", "label": "Diesel" }, ...]
model Param {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("params")
}

model Make {
  id     String  @id @default(cuid())
  name   String  @unique
  models Model[]

  @@map("makes")
}

/// A model always belongs to exactly one make, so `Vehicle` only stores
/// `modelId` — the make is reached through the relation, never duplicated.
model Model {
  id       String    @id @default(cuid())
  makeId   String
  make     Make      @relation(fields: [makeId], references: [id], onDelete: Restrict)
  name     String
  vehicles Vehicle[]

  @@unique([makeId, name])
  @@index([makeId])
  @@map("models")
}

model Vehicle {
  id      String @id @default(cuid())
  modelId String
  model   Model  @relation(fields: [modelId], references: [id], onDelete: Restrict)

  year     Int
  trim     String?
  nickname String?
  /// Required and unique: with VIN gone this is the vehicle's identity.
  plate    String  @unique
  colorHex String? @db.VarChar(7) // #RRGGBB

  engine       String?
  /// Code from params.FUEL_TYPE.
  fuelType     String?
  /// Code from params.TRANSMISSION_TYPE.
  transmission String?
  /// Code from params.DRIVE_TYPE.
  driveType    String?

  /// Stored in the base volume unit (L).
  tankCapacity      Decimal? @db.Decimal(6, 1)
  /// Stored in the base pressure unit (kPa).
  tirePressureFront Int?
  tirePressureRear  Int?

  oilType          String?
  oilSpecification String?
  batteryVoltage   Decimal? @db.Decimal(4, 1)

  /// Derived cache of the latest reading. Stored in the base distance unit (km).
  currentOdometer Decimal? @db.Decimal(10, 1)

  readings           VehicleReading[]
  fuelEntries        FuelEntry[]
  maintenanceEntries MaintenanceEntry[]
  maintenancePlans   MaintenancePlan[]
  documents          VehicleDocument[]

  /// Soft-delete flag. "Deleting" a vehicle sets this to false and touches no
  /// child rows. Restore by reactivating the same row — the plate stays
  /// reserved, so there is deliberately no duplicate-create path.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([modelId])
  @@map("vehicles")
}

/// Merged odometer + fuel-level timeline (replaces odometer_readings and
/// quick_updates). At least one measurement must be present.
model VehicleReading {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  odometer     Decimal? @db.Decimal(10, 1)
  fuelLevelPct Int?
  /// Code from params.READING_SOURCE.
  source       String?  @default("MANUAL")

  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  notes      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, recordedAt(sort: Desc)])
  @@map("vehicle_readings")
}

model FuelEntry {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  filledAt DateTime @default(now()) @db.Timestamptz(3)

  /// Stored in the base distance unit (km).
  odometer Decimal @db.Decimal(10, 1)
  /// Stored in the base volume unit (L).
  volume   Decimal @db.Decimal(8, 3)

  priceTotal Decimal @db.Decimal(12, 2)

  station  String?
  /// Code from params.FUEL_TYPE.
  fuelType String?

  /// Both flags are required for correct fuel-economy maths: a partial fill-up
  /// or a skipped logging session breaks the distance/volume ratio.
  isFullTank          Boolean @default(true)
  missedPreviousEntry Boolean @default(false)

  // ── stored derived values ──────────────────────────────────────────────
  /// priceTotal / volume.
  pricePerUnit Decimal? @db.Decimal(12, 4)
  /// distance since the previous fill / volume, in base distance per base volume.
  efficiency   Decimal? @db.Decimal(8, 3)
  /// odometer - previous odometer, in base distance.
  tripDistance Decimal? @db.Decimal(10, 1)

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, filledAt(sort: Desc)])
  @@map("fuel_entries")
}

/// Work that was actually done. Scheduling lives in MaintenancePlan.
model MaintenanceEntry {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  /// Code from params.MAINTENANCE_TYPE.
  type String

  title       String?
  description String?

  performedAt DateTime @default(now()) @db.Timestamptz(3)
  /// Stored in the base distance unit (km).
  odometer    Decimal? @db.Decimal(10, 1)
  cost        Decimal? @db.Decimal(12, 2)
  shop        String?
  notes       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, performedAt(sort: Desc)])
  @@index([type])
  @@map("maintenance_entries")
}

/// Work that is due. One row per recurring job.
model MaintenancePlan {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  /// Code from params.MAINTENANCE_TYPE.
  type String

  /// Stored in the base distance unit (km).
  intervalDistance Int?
  intervalMonths   Int?

  lastDoneAt      DateTime? @db.Timestamptz(3)
  /// Derived cache: lastDoneAt + intervalMonths.
  nextDueAt       DateTime? @db.Timestamptz(3)
  /// Stored in the base distance unit. Derived cache: last odometer + intervalDistance.
  nextDueDistance Int?

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, nextDueAt])
  @@index([type])
  @@map("maintenance_plans")
}

/// Documents. `group` splits personal documents (driver's licence) from
/// vehicle documents (insurance, registration); `vehicleId` is optional so a
/// personal document is stored once and not duplicated per car.
///
/// Documents are archived, never deleted: deactivating a vehicle also sets
/// `isActive = false` on its documents, and replacing an expired policy is a
/// deactivate + insert, so you keep the history.
model VehicleDocument {
  id String @id @default(cuid())

  /// Code from params.DOCUMENT_GROUP: PERSONAL | VEHICLE.
  group String

  /// Code from params.DOCUMENT_TYPE: DRIVER_LICENSE | INSURANCE | REGISTRATION.
  type String

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  number   String?
  provider String? // insurer / issuing authority

  issuedAt  DateTime? @db.Date
  expiresAt DateTime? @db.Date
  cost      Decimal?  @db.Decimal(12, 2)

  fileUrl String?
  notes   String?

  /// Archived instead of deleted. Set to false when its vehicle is deactivated.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, isActive])
  @@index([group, type, expiresAt(sort: Desc)])
  @@map("vehicle_documents")
}
